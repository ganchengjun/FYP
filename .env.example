# Copy this file to instance/.env for your own database, or use scripts/mysql.sh.
# Choose your own credentials; never commit instance/.env.
DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/irice?charset=utf8mb4
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_YOUR_RANDOM_SECRET
# Enable behind HTTPS in deployed environments:
COOKIE_SECURE=0
